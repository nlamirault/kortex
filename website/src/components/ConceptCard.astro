// SPDX-License-Identifier: Apache-2.0
import type { CollectionEntry } from 'astro:content';
import GrowthBadge from './GrowthBadge.astro';
import { TYPE_LABEL } from '../lib/growth';

interface Props {
  entry: CollectionEntry<'wiki'>;
}

const { entry } = Astro.props;
const { data } = entry;
const title = data.title ?? entry.id.split('/').pop();
const typeLabel = TYPE_LABEL[data.type] ?? data.type;
const href = `/${entry.id}/`;
---

<a class="card" href={href}>
  <div class="card__top">
    <span class="eyebrow">{typeLabel}</span>
    <GrowthBadge status={data.status} confidence={data.confidence} />
  </div>
  <h3 class="card__title">{title}</h3>
  {data.description && <p class="card__desc">{data.description}</p>}
  {data.tags && data.tags.length > 0 && (
    <div class="card__tags">
      {data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px var(--shadow-subtle);
    color: var(--text);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    min-width: 0;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--rust-border);
    box-shadow: 0 10px 28px var(--shadow);
    color: var(--text);
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .card__title {
    font-size: 1.25rem;
    color: var(--ink);
  }

  .card:hover .card__title {
    color: var(--rust-dark);
  }

  .card__desc {
    color: var(--muted);
    font-size: 0.925rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: auto;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    background: var(--surface-alt);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
  }
</style>
