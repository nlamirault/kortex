import { growthStage } from '../lib/growth';

interface Props {
  status?: string;
  confidence?: string;
}

const { status, confidence } = Astro.props;
const stage = growthStage(status, confidence);
---

<span class={`growth growth--${stage.key}`} title={stage.hint}>
  <span aria-hidden="true">{stage.emoji}</span>
  <span>{stage.label}</span>
</span>
