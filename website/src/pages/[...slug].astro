import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GrowthBadge from '../components/GrowthBadge.astro';
import { TYPE_LABEL, isStale } from '../lib/growth';

export const getStaticPaths = (async () => {
  const all = await getCollection('wiki');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const title = data.title ?? entry.id.split('/').pop();
const typeLabel = TYPE_LABEL[data.type] ?? data.type;
const stale = isStale(data.stale_after);
const verified = Array.isArray(data.verified) && data.verified.length > 0;
const updated =
  data.updated instanceof Date
    ? data.updated.toISOString().slice(0, 10)
    : (data.updated ?? undefined);
---

<Layout title={`${title} — Kortex`} description={data.description}>
  <article class="page container">
    <nav class="crumbs">
      <a href="/">Garden</a>
      <span aria-hidden="true">/</span>
      <a href={`/#${data.type}s`}>{typeLabel}</a>
    </nav>

    <header class="page__head">
      <div class="page__badges">
        <span class="eyebrow">{typeLabel}</span>
        <GrowthBadge status={data.status} confidence={data.confidence} />
        {stale && <span class="flag flag--stale" title="now ≥ stale_after">needs re-verify</span>}
        {!verified && <span class="flag flag--unverified">unverified</span>}
      </div>
      <h1 class="page__title">{title}</h1>
      {data.description && <p class="page__desc measure">{data.description}</p>}
      <dl class="meta">
        {data.domain && data.domain.length > 0 && (
          <div><dt>Domain</dt><dd>{data.domain.join(', ')}</dd></div>
        )}
        {data.confidence && <div><dt>Confidence</dt><dd>{data.confidence}</dd></div>}
        {updated && <div><dt>Updated</dt><dd>{updated}</dd></div>}
      </dl>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .page {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .crumbs {
    display: flex;
    gap: var(--space-xs);
    font-size: 0.85rem;
    color: var(--subtle);
    margin-bottom: var(--space-lg);
  }

  .crumbs a {
    color: var(--muted);
  }

  .crumbs a:hover {
    color: var(--rust);
  }

  .page__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--line);
  }

  .page__badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .page__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
  }

  .page__desc {
    font-size: 1.15rem;
    color: var(--muted);
  }

  .flag {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.12rem 0.5rem;
    border-radius: var(--radius-pill);
  }

  .flag--stale {
    background: var(--budding-soft);
    color: var(--warning);
  }

  .flag--unverified {
    background: var(--surface-alt);
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin: var(--space-xs) 0 0;
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .meta dt {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--subtle);
  }

  .meta dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text);
    font-family: var(--font-mono);
  }
</style>
