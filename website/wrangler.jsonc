{
  // Cloudflare Workers deploy for the Kortex wiki site.
  // Static assets (Astro build in ./dist) are served through worker.js, which
  // runs first on every request to enable Markdown content negotiation for
  // AI agents (Accept: text/markdown) and to stamp .well-known headers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kortex",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
  // Custom domain (kortex.lamirault.xyz) is attached in the Cloudflare
  // dashboard: Workers & Pages > kortex > Settings > Domains & Routes.
}
