{
  // SPDX-License-Identifier: Apache-2.0
  // Static Astro build served from ./dist, wrapped by a thin Worker that adds
  // Markdown content-negotiation (Accept: text/markdown) for AI agents.
  "name": "kortex",
  "main": "worker.js",
  "compatibility_date": "2026-04-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker before serving a static asset, so the Markdown
    // content-negotiation in worker.js applies to real pages (otherwise
    // Cloudflare serves the matching asset directly and skips the Worker).
    "run_worker_first": true
  }
}
